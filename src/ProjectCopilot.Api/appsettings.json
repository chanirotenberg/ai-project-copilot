{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "DocumentStorage": {
    // Directory holding uploaded document files. A relative path is resolved against the
    // application content root at startup. Every stored file lives directly in this directory
    // under a server-generated name; nothing is ever written outside it.
    "RootPath": "App_Data/documents"
  },

  "DocumentUpload": {
    // Maximum size of a single uploaded document file, in bytes (20 MB).
    "MaxFileSizeBytes": 20971520
  }
}
